
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Website</title>

    <link rel="stylesheet" href="../css/style.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="#">My Website</a>

            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="#home">Home</a>
                <a class="nav-link" href="#clock-section">Clock</a>
                <a class="nav-link" href="#about">About Us</a>
            </div>
        </div>
    </nav>

    <!-- Welcome Section -->
    <section class="welcome" id="home">

        <h2>Welcome To My Website</h2>

        <p>This Website Demonstrates JavaScript Timing Functions</p>

        <button class="btn btn-primary" onclick="showWelcome()">
            Show Welcome Message
        </button>

        <p id="message"></p>

    </section>

    <!-- Digital Clock -->
    <section class="clock-section" id="clock-section">

        <h3>Digital Clock</h3>

        <p>Current Time</p>

        <div id="clock">00:00:00</div>

        <button class="btn btn-success" onclick="startClock()">
            Start Clock
        </button>

        <button class="btn btn-danger" onclick="stopClock()">
            Stop Clock
        </button>

    </section>

    <!-- About Us -->
    <section class="about" id="about">

        <h4>About Us</h4>

        <p>
            This project uses HTML, CSS, Bootstrap and JavaScript
            to create a simple website.
        </p>

    </section>

    <script src="../js/script.js"></script>

</body>
</html>
