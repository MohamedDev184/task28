
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
}

/* Welcome Section */
.welcome {
    background-color: #f8f9fa;
    text-align: center;
    padding: 65px 20px;
}

.welcome h2 {
    color: #687985;
    margin-bottom: 15px;
}

.welcome p {
    color: #999;
    margin: 15px 0;
}

/* Digital Clock */
.clock-section {
    background-color: #202a36;
    color: white;
    text-align: center;
    padding: 45px 20px;
}

.clock-section h3 {
    font-size: 25px;
}

#clock {
    color: #00d9ff;
    font-size: 35px;
    font-weight: bold;
    margin: 20px;
}

/* Buttons */
button {
    margin: 5px;
}

/* About Us */
.about {
    background-color: #f8f9fa;
    text-align: center;
    padding: 40px 20px;
    color: #777;
}

.about h4 {
    margin-bottom: 15px;
}
